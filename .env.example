# Factory Scanner — copy this file to .env and fill in your values.

# Required — your Groq API key
GROQ_API_KEY=

# Optional — override the default vision model(s), comma-separated for fallback
GROQ_MODELS=qwen/qwen3.8-27b

# Optional — output token cap (default: 3000; app sets 5000 in production)
LLM_MAX_TOKENS=5000

# Optional — server port (default: 5050)
PORT=5050

# Optional — gunicorn worker count (default: 2)
WEB_CONCURRENCY=2
